// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountTier {
  FREE
  PLUS
  PRIME
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id            String  @id @default(cuid())
  email         String  @unique
  passwordHash  String
  emailVerified Boolean @default(false)
  verifyCode    String?
  resetToken    String?   @unique
  resetTokenExpiry DateTime?
  campus        String
  programLevel  String?
  pushToken     String?
  program       String?
  programKey    String?

  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")

  ghostId        String   @unique
  avatarEmoji    String   @default("👻")
  ownedCosmetics String[] @default([])

  tier          AccountTier @default(FREE)
  tierExpiresAt DateTime?
  status        AccountStatus @default(ACTIVE)

  streakCount       Int       @default(0)
  streakFreezeUntil DateTime?
  lastPostedAt      DateTime?

  lastStreakCount Int?
  streakBrokenAt  DateTime?

  ghostCoins Int @default(0)
  freeBoosts            Int      @default(0)
  freeBoostsWeekly      Int      @default(0)
  lastFreeBoostGrant    DateTime?
  freeStreakFreezeMonthly Int    @default(0)
  lastFreeFreezeGrant   DateTime?

  storageUsed  Float @default(0)
  storageLimit Int   @default(50)

  battleChampion Boolean @default(false)
  weeklyChampion Boolean @default(false)

  inviteCode    String   @unique @default(cuid())
  referredBy    String?
  referralCount Int      @default(0)

  createdAt DateTime @default(now())

  posts         Post[]
  comments      Comment[]
  battleEntries BattleEntry[]
  votes         Vote[]
  transactions  Transaction[]
  reports       Report[]       @relation("ReportedBy")
  earnings      Earning[]
  payouts       Payout[]
  notifications Notification[]
  deviceTokens  DeviceToken[]
  uploads       MediaUpload[]
  referrals         Referral[]   @relation("ReferrerReferrals")
  referredByReferral Referral?    @relation("ReferredReferrals")
  battleStats       BattleStats?
  searchHistory     SearchHistory[]
  savedSearches     SavedSearch[]
  campusBattleWins  CampusBattleWin[]
  heldChampionships CampusChampion[]
}

model MediaUpload {
  id        String   @id @default(cuid())
  fileKey   String   @unique
  url       String   @unique
  sizeBytes Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String?  @unique
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  status    String   @default("active")
  createdAt DateTime @default(now())

  @@index([userId, status])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Post {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  text     String?
  imageUrl String?
  voiceUrl String?
  type     String  @default("confession") // confession | gossip | meme | voice

  campus       String
  program      String?
  programLevel String?
  programKey   String?

  archived Boolean @default(false)

  visibility String @default("school") // "school" | "program"

  yeahs         Int @default(0)
  commentsCount Int @default(0)

  boosted      Boolean   @default(false)
  boostedUntil DateTime?
  isPrime      Boolean   @default(false)

  createdAt DateTime @default(now())

  comments Comment[]
  reports  Report[]     @relation("ReportedPost")
  upload   MediaUpload?
  hashtags PostHashtag[]

  @@index([campus, createdAt])
  @@index([campus, programKey, createdAt])
  @@index([userId, createdAt])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  ghostId   String
  text      String
  parentId  String?
  parent    Comment?  @relation("Replies", fields: [parentId], references: [id])
  replies   Comment[] @relation("Replies")
  yeahs     Int       @default(0)
  votes     CommentVote[]
  createdAt DateTime  @default(now())

  @@index([postId, parentId])
}

enum BattleType {
  SINGLE
  BRACKET
  RECURRING
}

enum BattleStatus {
  UPCOMING
  ACTIVE
  VOTING
  COMPLETED
  CANCELLED
}

enum BattleEntryType {
  TEXT
  IMAGE
  VOICE
}

model BattleSeason {
  id          String       @id @default(cuid())
  name        String
  campus      String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  battles     BattlePrompt[]
  @@index([campus, isActive])
}

model BattlePrompt {
  id          String       @id @default(cuid())
  text        String
  campus      String
  active      Boolean      @default(true)
  type        BattleType   @default(SINGLE)
  status      BattleStatus @default(UPCOMING)
  startsAt    DateTime     @default(now())
  endsAt      DateTime
  roundNumber Int          @default(1)
  totalRounds Int          @default(1)
  seasonId    String?
  season      BattleSeason? @relation(fields: [seasonId], references: [id])
  parentPromptId String?
  parentPrompt   BattlePrompt? @relation("BattleRounds", fields: [parentPromptId], references: [id])
  childPrompts   BattlePrompt[] @relation("BattleRounds")
  isPrimeOnly Boolean      @default(false)
  earlyAccessForPrime Boolean @default(false)
  entryType   BattleEntryType @default(TEXT)
  winnerEntryId String?
  winnerEntry   BattleEntry? @relation("WonBattles", fields: [winnerEntryId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  entries     BattleEntry[]
  @@index([campus, active, status])
  @@index([campus, startsAt])
  @@index([seasonId])
  @@index([parentPromptId])
}

model BattleEntry {
  id       String       @id @default(cuid())
  promptId String
  prompt   BattlePrompt @relation(fields: [promptId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  text        String?
  imageUrl    String?
  voiceUrl    String?
  entryType   BattleEntryType @default(TEXT)
  campus      String
  votes       Int     @default(0)
  isPrime     Boolean @default(false)
  roundNumber Int     @default(1)
  wonRound    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  votesBy       Vote[]
  wonBattles    BattlePrompt[] @relation("WonBattles")

  @@index([campus, promptId])
  @@index([promptId, roundNumber])
  @@unique([promptId, userId])
}

model Vote {
  id        String      @id @default(cuid())
  entryId   String
  entry     BattleEntry @relation(fields: [entryId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  createdAt DateTime    @default(now())

  @@unique([entryId, userId])
}

model PostView {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model Transaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  kind      String // boost | prime | plus | custom_name | freeze | restore | storage | cosmetic
  reference String @unique
  amount    Int
  status    String @default("pending") // pending | success | failed
  metadata  Json?

  createdAt DateTime @default(now())
}

model Report {
  id         String  @id @default(cuid())
  postId     String?
  post       Post?   @relation("ReportedPost", fields: [postId], references: [id], onDelete: SetNull)
  reporterId String
  reporter   User    @relation("ReportedBy", fields: [reporterId], references: [id])

  aiVerdict String?

  reason String
  status String @default("open") // open | reviewed | actioned | dismissed

  createdAt DateTime @default(now())

  @@unique([postId, reporterId])
}

model Earning {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  source   String // "post_vote" | "battle_win" | "leaderboard_bonus"
  sourceId String? // postId or battleEntryId
  amount   Int // in pesewas

  createdAt DateTime @default(now())
}

model Payout {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  amount                Int // in pesewas
  status                String  @default("pending") // pending | processing | approved | paid | rejected
  bankCode              String?
  accountNumber         String?
  accountName           String?
  providerTransferRef   String? @unique

  requestedAt DateTime  @default(now())
  processedAt DateTime?
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id])
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model PostVote {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model CommentVote {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
}

model AiDraft {
  id        String   @id @default(cuid())
  text      String
  status    String   @default("pending") // pending | published | rejected
  createdAt DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  href      String
  actorName String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  hits      Int      @default(0)
  windowStart DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actorId   String?
  targetId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([targetId])
  @@index([createdAt])
}

model Referral {
  id           String   @id @default(cuid())
  referrerId   String
  referrer     User     @relation("ReferrerReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId   String   @unique
  referred     User     @relation("ReferredReferrals", fields: [referredId], references: [id], onDelete: Cascade)
  status       String   @default("pending") // pending | completed
  rewardAmount Int      @default(0)
  createdAt    DateTime @default(now())
  completedAt  DateTime?

  @@index([referrerId, status])
  @@index([referredId])
}

model BattleStats {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalBattles Int      @default(0)
  totalEntries Int      @default(0)
  totalWins    Int      @default(0)
  totalVotes   Int      @default(0)
  winRate      Float    @default(0)
  currentStreak Int     @default(0)
  bestStreak   Int      @default(0)
  lastBattleAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model Hashtag {
  id        String   @id @default(cuid())
  tag       String   @unique
  campus    String
  postsCount Int     @default(0)
  trendingScore Float @default(0)
  lastUsedAt DateTime @default(now())
  createdAt DateTime @default(now())

  posts PostHashtag[]

  @@index([campus, trendingScore])
  @@index([campus, lastUsedAt])
}

model PostHashtag {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtagId String
  hashtag   Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@unique([postId, hashtagId])
  @@index([hashtagId])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  filters   Json?
  resultsCount Int   @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  query     String
  filters   Json?
  alertEnabled Boolean @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
}

model PaywallHit {
  id        String   @id @default(cuid())
  userId    String?
  feature   String
  pathname  String?
  createdAt DateTime @default(now())
  @@index([feature, createdAt])
  @@index([createdAt])
}

model CampusChampion {
  campus    String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wonAt     DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
}

model CampusBattleWin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus    String
  wins      Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([userId, campus])
  @@index([campus, wins])
}
