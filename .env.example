# Database (Neon/PostgreSQL)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# JWT - GENERATE NEW: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# Paystack - test keys for development, live keys for production
PAYSTACK_MODE="test"
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxx"
PAYSTACK_PLUS_PLAN_CODE="PLN_xxxxxxxxxx"
PAYSTACK_PRIME_PLAN_CODE="PLN_xxxxxxxxxx"
PAYSTACK_PLUS_ANNUAL_PLAN_CODE="PLN_xxxxxxxxxx"
PAYSTACK_PRIME_ANNUAL_PLAN_CODE="PLN_xxxxxxxxxx"
# Plan prices in pesewas (must match Paystack plan amounts). Used for admin revenue.
PAYSTACK_PLUS_PRICE_PESEWAS="1000"
PAYSTACK_PRIME_PRICE_PESEWAS="2000"
PAYSTACK_PLUS_ANNUAL_PRICE_PESEWAS="10000"
PAYSTACK_PRIME_ANNUAL_PRICE_PESEWAS="20000"
# Paystack signs webhooks with PAYSTACK_SECRET_KEY; do not create a second webhook secret.

# Server-side error alerts (Discord/Slack-compatible webhook)
ERROR_ALERT_WEBHOOK_URL=""

# Resend - GET FROM RESEND DASHBOARD
RESEND_API_KEY="re_xxxxxxxxxxxxx"

# UploadThing - GET FROM UPLOADTHING DASHBOARD
UPLOADTHING_TOKEN="sk_live_xxxxxxxxxxxxx"

# Admin - CHANGE THESE
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-secure-password"
# GENERATE NEW: openssl rand -base64 32
ADMIN_JWT_SECRET="your-super-secret-admin-jwt-key-min-32-chars"

# Firebase Admin (for native Android/iOS FCM push) - GET FROM FIREBASE CONSOLE
# Preferred: the three split values below. Literal \n in FIREBASE_PRIVATE_KEY is
# converted to real newlines automatically.
FIREBASE_PROJECT_ID="your-project"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Legacy fallback: full service-account JSON (still supported).
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk%40your-project.iam.gserviceaccount.com"}'

# Cron - GENERATE NEW: openssl rand -base64 32
CRON_SECRET="your-cron-secret"

# VAPID Keys for Web Push - GENERATE: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE..."
VAPID_PRIVATE_KEY="MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg..."

# OpenRouter (for AI moderation/posts) - GET FROM OPENROUTER.AI
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxx"

# Socket.io Server - Separate service for horizontal scaling
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"